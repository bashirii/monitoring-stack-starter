    {
      "id": 8,
      "type": "row",
      "title": "The service (demo-api): rate, errors, duration",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
