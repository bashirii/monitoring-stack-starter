# Copy to .env and adjust. The ports and retention below are not secret. Generated passwords live in ./secrets (made by scripts/secrets.sh); SMTP and Slack secrets go in .env, which git ignores.

# The address that serves Grafana and the other web pages on this machine only.
BIND_IP=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
MAILPIT_PORT=8025
DEMO_PORT=8000

# Where the links in alert emails and Slack messages point. Leave empty on one machine; behind a domain, set them (for example https://alerts.example.com).
#ALERTMANAGER_EXTERNAL_URL=
#PROMETHEUS_EXTERNAL_URL=

# How long Prometheus keeps data.
PROMETHEUS_RETENTION=15d

# Real alert delivery (optional). Run `python3 scripts/alerting.py` after changing these. This file is a template: keep real values in .env only.
# Email: any SMTP server. Gmail needs 2-step verification and an app password, not your normal password.
#SMTP_SERVER=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=you@example.com
#SMTP_PASSWORD=your-app-password
# Who receives the email. Default: SMTP_USER.
#ALERT_EMAIL_TO=you@example.com
# Slack: an incoming webhook, and the channel name for the message.
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#SLACK_CHANNEL=#alerts

