# Copy to .env and adjust. Nothing here is a secret: passwords live in ./secrets (made by scripts/secrets.sh).

# The address that serves Grafana and the other web pages on this machine only.
BIND_IP=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
MAILPIT_PORT=8025
DEMO_PORT=8000

# How long Prometheus keeps data.
PROMETHEUS_RETENTION=15d
